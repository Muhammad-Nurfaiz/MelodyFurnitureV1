JNT_CARGO_API_KEY=null
JNT_CARGO_API_SECRET=null
JNT_CARGO_WEBHOOK_URL=null
JNT_CARGO_TIMEOUT=30

SENTRAL_CARGO_BASE_URL=null
SENTRAL_CARGO_API_KEY=null
